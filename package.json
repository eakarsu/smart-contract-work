    "@types/node": "^16.11.7",
    "del-cli": "^4.0.1",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "@aave/protocol-js": "^4.3.0",
    "@enzymefinance/ethers": "^1.0.10",
    "@enzymefinance/protocol": "^3.0.1",
